# Web — copy: cp .env.example .env
# Backend chạy riêng; web đọc file này qua apps/web/next.config.ts

# Supabase (bắt buộc — web derive NEXT_PUBLIC_*)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API (dev mặc định http://127.0.0.1:8000 nếu không set)
# API_PUBLIC_URL=http://127.0.0.1:8000

# VietMap Maps API — geocode, autocomplete, static map (VN). Lấy key tại https://maps.vietmap.vn/
# VIETMAP_API_KEY=your_vietmap_api_key

# OTA hotel scrape (Playwright) — timeout job phải ≥ TRIP_OTA_HARD_DEADLINE_MS + 30s
# TRIP_OTA_HARD_DEADLINE_MS=90000
# TRIP_OTA_SITES=booking,agoda,vntrip
# HOTEL_AGENT_JOB_TIMEOUT_MS=120000

# Pexels — ảnh cover thành phố cho "Chuyến đi gần đây". Lấy key tại https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key

# Google Maps / Places — ảnh agenda nhanh (Places Photos API). Bật Places API (New) trên GCP.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# TRIP_PLACES_PHOTOS_ENABLED=true

# DuckDuckGo Image Search — tier ảnh địa điểm chính, HTTP thuần, không cần API key.
# TRIP_DDG_IMAGES_ENABLED=true
# TRIP_DDG_IMAGES_CONCURRENCY=6

# --- Marketplace payments / payout / media moderation ---
# true = payment simulation safe mode (no real PSP). Set false to wire a real gateway.
PAYMENT_SIMULATION_MODE=true
# Default platform commission percentage when a business has no commission_rate.
DEFAULT_PLATFORM_COMMISSION_RATE=10
# true = auto-mark payouts paid (simulation). false = admin/worker processes payouts.
PAYOUT_AUTO_PROCESS=false
# true = business media requires admin approval before it is visible.
BUSINESS_MEDIA_MODERATION_REQUIRED=true

# --- PayOS (set PAYMENT_SIMULATION_MODE=false to enable real payments) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_BASE=https://api-merchant.payos.vn
# Where PayOS redirects the user after pay/cancel (web URL or app deep link).
PAYOS_RETURN_URL=https://wandertale.app/payment/success
PAYOS_CANCEL_URL=https://wandertale.app/payment/cancel
