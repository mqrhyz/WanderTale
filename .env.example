# Web — copy: cp .env.example .env
# Backend chạy riêng; web đọc file này qua apps/web/next.config.ts

# Supabase (bắt buộc — web derive NEXT_PUBLIC_*)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API (dev mặc định http://127.0.0.1:8000 nếu không set)
# API_PUBLIC_URL=http://127.0.0.1:8000

# VietMap Maps API — geocode, autocomplete, static map (VN). Lấy key tại https://maps.vietmap.vn/
# VIETMAP_API_KEY=your_vietmap_api_key

# OTA hotel scrape (Playwright) — timeout job phải ≥ TRIP_OTA_HARD_DEADLINE_MS + 30s
# TRIP_OTA_HARD_DEADLINE_MS=90000
# TRIP_OTA_SITES=booking,agoda,vntrip
# HOTEL_AGENT_JOB_TIMEOUT_MS=120000

# Pexels — ảnh cover thành phố cho "Chuyến đi gần đây". Lấy key tại https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key

# Google Maps / Places — ảnh agenda nhanh (Places Photos API). Bật Places API (New) trên GCP.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# TRIP_PLACES_PHOTOS_ENABLED=true

# DuckDuckGo Image Search — tier ảnh địa điểm chính, HTTP thuần, không cần API key.
# TRIP_DDG_IMAGES_ENABLED=true
# TRIP_DDG_IMAGES_CONCURRENCY=6
