# Web — copy: cp .env.example .env
# Backend chạy riêng; web đọc file này qua apps/web/next.config.ts

# Supabase (bắt buộc — web derive NEXT_PUBLIC_*)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API (dev mặc định http://127.0.0.1:8000 nếu không set)
# API_PUBLIC_URL=http://127.0.0.1:8000
